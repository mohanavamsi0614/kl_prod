{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
    "server.ts",
    "controllers/**/*",
    "routes/**/*",
    "middleware/**/*",
    "utils/**/*",
    "lib/**/*",
    "types/**/*"
  ]
}
